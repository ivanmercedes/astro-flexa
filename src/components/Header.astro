---
import { flexa } from '../lib/flexa';

const primaryMenu = await flexa.menu('primary');
---

<header class="border-b border-light">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <a href="/" class="font-heading text-lg font-bold text-dark">Astro Flexa</a>
        <nav>
            <ul class="flex gap-6 text-sm font-semibold">
                {primaryMenu.map((item) => (
                    <li>
                        <a href={item.url} target={item.target || '_self'} class="hover:text-primary">{item.title}</a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>
